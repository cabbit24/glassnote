<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<Pane fx:id="configPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cabbit24.glassnote.ConfigController">
   <children>
      <VBox prefHeight="200.0" prefWidth="407.0">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="5.0">
               <children>
                  <Label text="Window Transparency:" />
                  <Slider fx:id="transparencySlider" blockIncrement="0.01" max="1.0" min="0.1" onMouseReleased="#setTransparency" value="1.0">
                     <HBox.margin>
                        <Insets top="4.0" />
                     </HBox.margin>
                  </Slider>
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Foreground Color:" />
                  <ColorPicker fx:id="foregroundColorPicker" editable="true" onAction="#changeForegroundColor">
                     <value>
                        <Color />
                     </value></ColorPicker>
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Background Color:" />
                  <ColorPicker fx:id="backgroundColorPicker" onAction="#changeBackgroundColor">
                     <value>
                        <Color />
                     </value></ColorPicker>
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Font Color:" />
                  <ColorPicker fx:id="fontColorPicker" onAction="#changeFontColor" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label text="Change Font:" />
                  <Button mnemonicParsing="false" onAction="#loadCustomFont" text="Load Custom Font" />
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <CheckBox fx:id="wifiCheckbox" mnemonicParsing="false" onAction="#disableWifi" text="Disable Wi-Fi on startup" />
               </children>
            </HBox>
            <HBox layoutX="15.0" layoutY="141.0" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#resetConfig" text="Reset Config File" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </children>
</Pane>
